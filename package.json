{
  "name": "playGo",
  "version": "1.6.05",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "ionic": "ionic",
    "code-push": "code-push",
    "code-push:login": "code-push login https://code-push-server.platform.smartcommunitylab.it",
    "code-push:android:release:prod": "code-push release it.dslab.playgo-android android/app/src/main/assets/public --deploymentName Production",
    "code-push:android:release:stage": "code-push release it.dslab.playgo-android android/app/src/main/assets/public --deploymentName Staging",
    "code-push:android:clear:prod": "code-push deployment clear it.dslab.playgo-android Production",
    "code-push:android:clear:stage": "code-push deployment clear it.dslab.playgo-android Staging",
    "code-push:android:list": "code-push deployment ls it.dslab.playgo-android",
    "code-push:android:history:prod": "code-push deployment history it.dslab.playgo-android Production",
    "code-push:android:history:stage": "code-push deployment history it.dslab.playgo-android Staging",
    "code-push:ios:release:prod": "code-push release it.dslab.playgo-ios ios/App/App/public --deploymentName Production",
    "code-push:ios:release:stage": "code-push release it.dslab.playgo-ios ios/App/App/public --deploymentName Staging",
    "code-push:ios:clear:prod": "code-push deployment clear it.dslab.playgo-ios Production",
    "code-push:ios:clear:stage": "code-push deployment clear it.dslab.playgo-ios Staging",
    "code-push:ios:list": "code-push deployment ls it.dslab.playgo-ios",
    "code-push:ios:history:prod": "code-push deployment history it.dslab.playgo-ios Production",
    "code-push:ios:history:stage": "code-push deployment history it.dslab.playgo-ios Staging",
    "resources": "capacitor-resources -p android,ios",
    "start": "npm run before-build && ng serve --configuration=development",
    "start:testing": "npm run before-build && ng serve --configuration=testing",
    "start:prod": "npm run before-build && ng serve --configuration=production",
    "build": "npm run before-build && ng build --configuration=development",
    "build:prod": "npm run before-build && ng build --configuration=production",
    "build:stage": "npm run before-build && cross-env FLAVOR=stage ng build --configuration=stage",
    "sync:stage": "cross-env FLAVOR=stage npx cap sync --inline",
    "ionic:sync:stage": "cross-env FLAVOR=stage npm run build:stage && cross-env FLAVOR=stage npm run sync:stage",
    "ionic:sync:testing": "ionic cap sync --configuration=testing",
    "sync:prod": "cross-env FLAVOR=production npx cap sync --inline",
    "ionic:sync:prod": "cross-env FLAVOR=production npm run build:prod && cross-env FLAVOR=production npm run sync:prod npm run build:prod && npm run sync:prod",
    "ionic:sync:android:prod": "ionic cap sync --inline android --prod",
    "ionic:sync:ios:prod": "ionic cap sync --inline ios --prod",
    "ionic:build:before": "npm run before-build",
    "before-build": "node git-version.js && node check-node-version.js",
    "e2e": "npm run before-build && ng e2e",
    "test": "npm run before-build && ng test",
    "eslint": "eslint",
    "prettier": "prettier",
    "prettier:write": "prettier . --write",
    "prettier:check": "prettier . --check",
    "generate-api": "sh ./generate-api.sh",
    "getTypescriptVersion": "tsc -v",
    "postinstall": "node check-node-version.js && node fcm-library.js",
    "deploy:stage:android": "npm run build:stage && cross-env FLAVOR=stage PLATFORM=android node scripts/deploy-update.js",
    "deploy:stage:ios": "npm run build:stage && cross-env FLAVOR=stage PLATFORM=ios node scripts/deploy-update.js",
    "deploy:prod:android": "npm run build:prod && cross-env FLAVOR=production PLATFORM=android node scripts/deploy-update.js",
    "deploy:prod:ios": "npm run build:prod && cross-env FLAVOR=production PLATFORM=ios node scripts/deploy-update.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@asymmetrik/ngx-leaflet": "^17.0.0",
    "@bluehalo/ngx-leaflet": "^20.0.0",
    "@capacitor-community/fcm": "^7.1.3",
    "@capacitor-community/firebase-analytics": "^7.0.1",
    "@capacitor-community/http": "^1.4.1",
    "@capacitor-community/safe-area": "^7.0.0-beta.2",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "7.1.0",
    "@capacitor/app-launcher": "^7.0.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/barcode-scanner": "^2.2.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.2",
    "@capacitor/dialog": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^8.0.0-next.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/screen-orientation": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@capgo/capacitor-updater": "^6.27.11",
    "@ionic/angular": "^8.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@transistorsoft/capacitor-background-fetch": "^7.1.0",
    "@transistorsoft/capacitor-background-geolocation": "^7.2.3",
    "angularx-qrcode": "^20.0.0",
    "backoff-rxjs": "^7.0.0",
    "capacitor-secure-storage-plugin": "^0.11.0",
    "chart.js": "^4.5.1",
    "cordova-plugin-screen-orientation": "^3.0.4",
    "cordova-sqlite-storage": "^7.0.0",
    "es6-promise-plugin": "^4.2.2",
    "ionic-appauth": "^2.1.0",
    "ionic-selectable": "^5.0.3",
    "ionicons": "^7.0.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "protractor": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@azure/storage-blob": "^12.31.0",
    "@capacitor/cli": "^7.4.4",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@ionic/angular-toolkit": "^12.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/to-px": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "git-describe": "^4.1.1",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "lodash-es": "^4.17.21",
    "to-px": "^1.1.0",
    "typescript": "~5.8.0"
  },
  "description": "An Ionic project"
}
